"Welcome to Launchy" = "Selamat datang di Launchy";
"This SwiftUI scaffold is ready for your ideas." = "Kerangka SwiftUI ini siap untuk ide-ide Anda.";
"Increase Counter" = "Tambahkan penghitung";
"Counter: %lld" = "Penghitung: %lld";

"Floaty or fullscreen" = "Floaty atau layar penuh";
"Pick the layout that fits the moment. Floaty hovers above your desktop, while fullscreen feels like classic Launchpad." = "Pilih tata letak yang cocok untuk saat ini. Floaty melayang di atas desktop Anda, sementara layar penuh terasa seperti Launchpad klasik.";
"Floaty mode" = "Mode Floaty";
"A panel that stays light and quick. Hide the Dock icon if you want a minimal feel." = "Panel ringan dan cepat. Sembunyikan ikon Dock jika Anda ingin tampilan minimal.";
"Fullscreen mode" = "Mode layar penuh";
"Fill the screen for a focused, grid-first workflow." = "Isi layar untuk alur kerja fokus yang berorientasi pada grid.";
"Flip instantly" = "Beralih instan";
"Add a layout toggle shortcut in Settings to jump between modes anytime." = "Tambahkan pintasan pengalih tata letak di Pengaturan agar bisa berpindah mode kapan saja.";
"Hotkeys you control" = "Hotkey yang Anda kendalikan";
"Launchy ships with Cmd+Shift+Space, but you can set your own shortcuts in Settings > Keyboard." = "Launchy hadir dengan Cmd+Shift+Space, tapi Anda bisa mengatur pintasan sendiri di Pengaturan > Keyboard.";
"Toggle Launchy anywhere" = "Togol Launchy di mana saja";
"Record the shortcut you want to open or hide the launcher." = "Rekam pintasan yang ingin Anda gunakan untuk membuka atau menyembunyikan peluncur.";
"Layout toggle" = "Pengalih tata letak";
"Set an optional hotkey to swap floaty and fullscreen on demand." = "Tetapkan hotkey opsional untuk menukar Floaty dan layar penuh sesuai kebutuhan.";
"Reset friendly" = "Reset ramah pengguna";
"Use Reset in Settings if you ever want the defaults back." = "Gunakan Reset di Pengaturan jika Anda ingin kembali ke nilai bawaan.";
"Search & organize" = "Cari & atur";
"Type to filter instantly, drag to reorder, and build folders when you need them." = "Ketik untuk memfilter instan, seret untuk menyusun ulang, dan buat folder saat Anda membutuhkannya.";
"Instant search" = "Pencarian instan";
"The search bar narrows results as you type, then Enter launches the first match." = "Bilah pencarian mempersempit hasil saat Anda mengetik, lalu Enter meluncurkan hasil pertama.";
"Rearrange easily" = "Susun ulang dengan mudah";
"Drag icons to reorder pages. Hold Option or Shift while dragging to create folders." = "Seret ikon untuk menyusun ulang halaman. Tahan Option atau Shift saat menyeret untuk membuat folder.";
"Name folders fast" = "Beri nama folder dengan cepat";
"Drop onto another app to make a folder, then rename it inline." = "Seret ke aplikasi lain untuk membuat folder, lalu ganti namanya di tempat.";
"Right-click for power" = "Klik kanan untuk fitur lebih";
"Context menus unlock more control wherever you click." = "Menu konteks memberi kontrol lebih di mana pun Anda klik.";
"App actions" = "Tindakan aplikasi";
"Right-click any app to rename it, move pages, hide it, or jump into folders." = "Klik kanan aplikasi apa pun untuk mengganti nama, Pindahkan halaman, sembunyikan, atau masuk ke folder.";
"Folder tools" = "Alat folder";
"Rename, reorder, and move folders between pages with the same menu." = "Ubah nama, susun ulang, dan pindahkan folder antar halaman menggunakan menu yang sama.";
"Blank canvas" = "Kanvas kosong";
"Right-click the background to drop in a new folder whenever you need one." = "Klik kanan latar belakang untuk menambahkan folder baru kapan pun Anda mau.";
