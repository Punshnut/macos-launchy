"Welcome to Launchy" = "Willkommen bei Launchy";
"This SwiftUI scaffold is ready for your ideas." = "Dieses SwiftUI-Gerüst ist bereit für deine Ideen.";
"Increase Counter" = "Zähler erhöhen";
"Counter: %lld" = "Zähler: %lld";

"Floaty or fullscreen" = "Schwebend oder Vollbild";
"Pick the layout that fits the moment. Floaty hovers above your desktop, while fullscreen feels like classic Launchpad." = "Wähle das Layout, das gerade passt. Schwebend liegt über dem Schreibtisch, Vollbild wirkt wie das klassische Launchpad.";
"Floaty mode" = "Schwebemodus";
"A panel that stays light and quick. Hide the Dock icon if you want a minimal feel." = "Ein leichtes, schnelles Panel. Blende das Dock-Symbol aus, wenn du es minimal magst.";
"Fullscreen mode" = "Vollbildmodus";
"Fill the screen for a focused, grid-first workflow." = "Nutze den ganzen Bildschirm für einen fokussierten, grid-basierten Workflow.";
"Flip instantly" = "Sofort umschalten";
"Add a layout toggle shortcut in Settings to jump between modes anytime." = "Lege in den Einstellungen einen Kurzbefehl fest, um jederzeit zwischen den Modi zu wechseln.";
"Hotkeys you control" = "Hotkeys unter deiner Kontrolle";
"Launchy ships with Cmd+Shift+Space, but you can set your own shortcuts in Settings > Keyboard." = "Launchy kommt mit Cmd+Shift+Leertaste, aber du kannst deine eigenen Kürzel unter Einstellungen > Tastatur festlegen.";
"Toggle Launchy anywhere" = "Launchy überall ein-/ausblenden";
"Record the shortcut you want to open or hide the launcher." = "Nimm das Kürzel auf, mit dem du den Launcher öffnest oder ausblendest.";
"Layout toggle" = "Layout wechseln";
"Set an optional hotkey to swap floaty and fullscreen on demand." = "Lege optional einen Hotkey fest, um bei Bedarf zwischen schwebend und Vollbild zu wechseln.";
"Reset friendly" = "Zurücksetzen leicht gemacht";
"Use Reset in Settings if you ever want the defaults back." = "Nutze „Zurücksetzen“ in den Einstellungen, wenn du zu den Standardwerten zurück willst.";
"Search & organize" = "Suchen & organisieren";
"Type to filter instantly, drag to reorder, and build folders when you need them." = "Tippe, um sofort zu filtern, ziehe zum Neuordnen und erstelle Ordner, wenn du sie brauchst.";
"Instant search" = "Sofortsuche";
"The search bar narrows results as you type, then Enter launches the first match." = "Die Suche verfeinert während der Eingabe; Enter startet den ersten Treffer.";
"Rearrange easily" = "Einfach umsortieren";
"Drag icons to reorder pages. Hold Option or Shift while dragging to create folders." = "Ziehe Symbole, um Seiten neu zu ordnen. Halte Option oder Shift gedrückt, um Ordner zu erstellen.";
"Name folders fast" = "Ordner schnell benennen";
"Drop onto another app to make a folder, then rename it inline." = "Auf eine andere App ziehen, um einen Ordner zu erstellen, und direkt umbenennen.";
"Right-click for power" = "Rechtsklick für mehr Möglichkeiten";
"Context menus unlock more control wherever you click." = "Kontextmenüs geben dir überall mehr Kontrolle.";
"App actions" = "App-Aktionen";
"Right-click any app to rename it, move pages, hide it, or jump into folders." = "Rechtsklick auf eine App zum Umbenennen, Verschieben, Ausblenden oder in Ordner legen.";
"Folder tools" = "Ordnerwerkzeuge";
"Rename, reorder, and move folders between pages with the same menu." = "Ordner umbenennen, sortieren und zwischen Seiten verschieben – alles im selben Menü.";
"Blank canvas" = "Leere Leinwand";
"Right-click the background to drop in a new folder whenever you need one." = "Rechtsklicke auf den Hintergrund, um jederzeit einen neuen Ordner anzulegen.";
