"Welcome to Launchy" = "Selamat datang ke Launchy";
"This SwiftUI scaffold is ready for your ideas." = "Rangka SwiftUI ini sedia untuk idea anda.";
"Increase Counter" = "Tambah Kaunter";
"Counter: %lld" = "Kaunter: %lld";

"Floaty or fullscreen" = "Floaty atau skrin penuh";
"Pick the layout that fits the moment. Floaty hovers above your desktop, while fullscreen feels like classic Launchpad." = "Pilih susun atur yang sesuai dengan waktu ini. Floaty melayang di atas desktop anda, manakala skrin penuh terasa seperti Launchpad klasik.";
"Floaty mode" = "Mod Floaty";
"A panel that stays light and quick. Hide the Dock icon if you want a minimal feel." = "Panel yang ringan dan pantas. Sembunyikan ikon Dock jika anda mahukan rasa minimal.";
"Fullscreen mode" = "Mod skrin penuh";
"Fill the screen for a focused, grid-first workflow." = "Penuhi skrin untuk aliran kerja berfokus, berasaskan grid.";
"Flip instantly" = "Tukar serta-merta";
"Add a layout toggle shortcut in Settings to jump between modes anytime." = "Tambah pintasan togol susun atur dalam Settings untuk bertukar antara mod pada bila-bila masa.";
"Hotkeys you control" = "Hotkey di bawah kawalan anda";
"Launchy ships with Cmd+Shift+Space, but you can set your own shortcuts in Settings > Keyboard." = "Launchy disertakan dengan Cmd+Shift+Space, tetapi anda boleh tetapkan pintasan sendiri dalam Settings > Keyboard.";
"Toggle Launchy anywhere" = "Togol Launchy di mana-mana";
"Record the shortcut you want to open or hide the launcher." = "Rakam pintasan yang anda mahu untuk membuka atau menyembunyikan pelancar.";
"Layout toggle" = "Togol susun atur";
"Set an optional hotkey to swap floaty and fullscreen on demand." = "Tetapkan hotkey pilihan untuk menukar floaty dan skrin penuh mengikut keperluan.";
"Reset friendly" = "Mesra reset";
"Use Reset in Settings if you ever want the defaults back." = "Gunakan Reset dalam Settings jika anda mahu kembali ke tetapan lalai.";
"Search & organize" = "Cari & susun";
"Type to filter instantly, drag to reorder, and build folders when you need them." = "Taip untuk menapis serta-merta, seret untuk menyusun semula, dan bina folder apabila anda perlukan.";
"Instant search" = "Carian serta-merta";
"The search bar narrows results as you type, then Enter launches the first match." = "Bar carian menyempitkan hasil semasa anda menaip, kemudian Enter melancarkan padanan pertama.";
"Rearrange easily" = "Susun semula dengan mudah";
"Drag icons to reorder pages. Hold Option or Shift while dragging to create folders." = "Seret ikon untuk menyusun semula halaman. Tahan Option atau Shift semasa menyeret untuk mencipta folder.";
"Name folders fast" = "Namakan folder dengan pantas";
"Drop onto another app to make a folder, then rename it inline." = "Lepaskan ke atas aplikasi lain untuk membuat folder, kemudian namakannya terus di situ.";
"Right-click for power" = "Klik kanan untuk lebih kuasa";
"Context menus unlock more control wherever you click." = "Menu konteks membuka lebih kawalan di mana sahaja anda klik.";
"App actions" = "Tindakan aplikasi";
"Right-click any app to rename it, move pages, hide it, or jump into folders." = "Klik kanan mana-mana aplikasi untuk menamakannya semula, memindah halaman, menyembunyikannya, atau masuk ke folder.";
"Folder tools" = "Alat folder";
"Rename, reorder, and move folders between pages with the same menu." = "Namakan semula, susun semula, dan pindahkan folder antara halaman dengan menu yang sama.";
"Blank canvas" = "Kanvas kosong";
"Right-click the background to drop in a new folder whenever you need one." = "Klik kanan latar belakang untuk menambah folder baharu apabila anda perlukan.";
