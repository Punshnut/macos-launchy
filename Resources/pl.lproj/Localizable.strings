"Welcome to Launchy" = "Witamy w Launchy";
"This SwiftUI scaffold is ready for your ideas." = "Ten szkielet SwiftUI jest gotowy na Twoje pomysły.";
"Increase Counter" = "Zwiększ licznik";
"Counter: %lld" = "Licznik: %lld";

"Floaty or fullscreen" = "Tryb pływający lub pełny ekran";
"Pick the layout that fits the moment. Floaty hovers above your desktop, while fullscreen feels like classic Launchpad." = "Wybierz układ pasujący do sytuacji. Tryb pływający unosi się nad biurkiem, a pełny ekran przypomina klasyczny Launchpad.";
"Floaty mode" = "Tryb pływający";
"A panel that stays light and quick. Hide the Dock icon if you want a minimal feel." = "Panel lekki i szybki. Ukryj ikonę Docka, jeśli chcesz minimalistyczny wygląd.";
"Fullscreen mode" = "Tryb pełnoekranowy";
"Fill the screen for a focused, grid-first workflow." = "Wypełnij ekran dla skupionej pracy opartej na siatce.";
"Flip instantly" = "Przełączaj natychmiast";
"Add a layout toggle shortcut in Settings to jump between modes anytime." = "Dodaj skrót przełączania układu w Ustawieniach, aby skakać między trybami w każdej chwili.";
"Hotkeys you control" = "Skróty pod Twoją kontrolą";
"Launchy ships with Cmd+Shift+Space, but you can set your own shortcuts in Settings > Keyboard." = "Launchy ma domyślnie Cmd+Shift+Space, ale możesz ustawić własne skróty w Ustawieniach > Klawiatura.";
"Toggle Launchy anywhere" = "Przełącz Launchy wszędzie";
"Record the shortcut you want to open or hide the launcher." = "Nagraj skrót, którego chcesz używać do otwierania lub ukrywania launchera.";
"Layout toggle" = "Przełącznik układu";
"Set an optional hotkey to swap floaty and fullscreen on demand." = "Ustaw opcjonalny skrót, aby zamieniać tryb pływający i pełny ekran na żądanie.";
"Reset friendly" = "Łatwe resetowanie";
"Use Reset in Settings if you ever want the defaults back." = "Użyj Reset w Ustawieniach, jeśli chcesz wrócić do domyślnych ustawień.";
"Search & organize" = "Szukaj i porządkuj";
"Type to filter instantly, drag to reorder, and build folders when you need them." = "Pisz, by natychmiast filtrować, przeciągaj, by zmieniać kolejność, i twórz foldery, gdy ich potrzebujesz.";
"Instant search" = "Natychmiastowe wyszukiwanie";
"The search bar narrows results as you type, then Enter launches the first match." = "Pasek wyszukiwania zawęża wyniki podczas pisania, a Enter uruchamia pierwszy wynik.";
"Rearrange easily" = "Łatwe porządkowanie";
"Drag icons to reorder pages. Hold Option or Shift while dragging to create folders." = "Przeciągaj ikony, aby zmieniać kolejność stron. Przytrzymaj Option lub Shift podczas przeciągania, aby tworzyć foldery.";
"Name folders fast" = "Szybkie nazywanie folderów";
"Drop onto another app to make a folder, then rename it inline." = "Upuść na inną aplikację, aby utworzyć folder, a potem zmień jego nazwę na miejscu.";
"Right-click for power" = "Kliknij prawym przyciskiem, by zyskać więcej";
"Context menus unlock more control wherever you click." = "Menu kontekstowe daje więcej kontroli w każdym miejscu.";
"App actions" = "Akcje aplikacji";
"Right-click any app to rename it, move pages, hide it, or jump into folders." = "Kliknij prawym przyciskiem dowolną aplikację, aby zmienić jej nazwę, przenieść strony, ukryć ją lub wejść do folderów.";
"Folder tools" = "Narzędzia folderów";
"Rename, reorder, and move folders between pages with the same menu." = "Zmieniaj nazwy, kolejność i przenoś foldery między stronami z tego samego menu.";
"Blank canvas" = "Puste płótno";
"Right-click the background to drop in a new folder whenever you need one." = "Kliknij prawym przyciskiem tło, aby dodać nowy folder, kiedy tylko potrzebujesz.";
